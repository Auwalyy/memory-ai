NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/memoryai_nigeria

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_min_64_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google AI (Gemma via Gemini API)
GOOGLE_GEMINI_API_KEY=your_google_ai_studio_key
GEMMA_MODEL=gemma-4-27b-it
EMBEDDING_MODEL=text-embedding-004

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# App
FRONTEND_URL=https://memory-ai-two.vercel.app
MAX_FILE_SIZE_MB=50
MAX_AUDIO_SIZE_MB=25

# Public URL of this API, used to build playback links for locally stored
# recordings when Cloudinary is not configured (defaults to the request host)
BACKEND_PUBLIC_URL=

# ── N-ATLAS (core language technology) ──────────────────────────────────────
# Self-hosted — see natlas-gateway/README.md. Never expose these to the frontend.
NATLAS_ASR_ENDPOINT=http://localhost:8080/v1/audio/transcriptions
NATLAS_LLM_ENDPOINT=http://localhost:8080/v1/chat/completions
NATLAS_API_KEY=
NATLAS_MODEL=NCAIR1/N-ATLaS
NATLAS_ASR_MODEL=NCAIR1/Hausa-ASR
# openai = multipart upload (gateway/OpenAI style); raw = audio bytes body (HF Inference Endpoint)
NATLAS_ASR_FORMAT=openai
NATLAS_TIMEOUT_MS=120000
# Optional per-language ASR routing, e.g. NATLAS_ASR_ENDPOINT_YORUBA=
# Development only: set to "gemma" to use Gemma when NATLAS_LLM_ENDPOINT is empty.
# Provenance then records provider "gemma-fallback", never N-ATLAS.
NATLAS_LLM_FALLBACK=
